    lastHtfDailyFvgEvent := htfDailyFvgEventId
    selectedFill = htfDailyFvgDirection == 1 ? bullishFvgColor : bearishFvgColor
    selectedBorder = htfDailyFvgDirection == 1 ? bullishFvgBorder : bearishFvgBorder
    mainBox = box.new(
         left = htfDailyFvgLeftTime,
         top = htfDailyFvgTop,
         right = htfDailyFvgRightTime,
         bottom = htfDailyFvgBottom,
         xloc = xloc.bar_time,
         bgcolor = selectedFill,
         border_color = selectedBorder,
         border_width = fvgBorderWidth,
         force_overlay = true
    )
    mainLabel = label.new(
         x = int(math.avg(htfDailyFvgLeftTime, htfDailyFvgRightTime)),
         y = math.avg(htfDailyFvgTop, htfDailyFvgBottom),
         text = f_detectionTfLabel("D") + " " + str.format_time(htfDailyFvgEventId, "ha", sessionTimezone),
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = selectedBorder,
         size = size.tiny,
         textalign = text.align_center,
         force_overlay = true
    )
    array.push(htfDailyMainBoxes, mainBox)
    array.push(htfDailyMainLabels, mainLabel)
    while array.size(htfDailyMainBoxes) > timeframeFvgHistory
        oldMainBox = array.shift(htfDailyMainBoxes)
        oldMainLabel = array.shift(htfDailyMainLabels)
        if not na(oldMainBox)
            box.delete(oldMainBox)
        if not na(oldMainLabel)
            label.delete(oldMainLabel)

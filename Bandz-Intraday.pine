// ============================================================================
// BANDZ CALENDAR SEPARATORS, DAY LABELS, AND CUSTOM TIMESTAMPS
// ============================================================================
const int BANDZ_CALENDAR_CHANNEL_CAP = 60
const int BANDZ_CALENDAR_LABEL_CAP = 80
const int BANDZ_CALENDAR_DAILY_CHANNEL = 0
const int BANDZ_CALENDAR_WEEKLY_CHANNEL = 1
const int BANDZ_CALENDAR_MONTHLY_CHANNEL = 2
const int BANDZ_CALENDAR_YEARLY_CHANNEL = 3
const int BANDZ_CALENDAR_TIMESTAMP_1_CHANNEL = 4
const int BANDZ_CALENDAR_TIMESTAMP_2_CHANNEL = 5
const int BANDZ_CALENDAR_TIMESTAMP_3_CHANNEL = 6
const int BANDZ_CALENDAR_TIMESTAMP_4_CHANNEL = 7
string calendarSettingsGroup = "Calendar - Settings"
int calendarDrawingLimit = input.int(1, "Drawing Limit", minval=1, maxval=BANDZ_CALENDAR_CHANNEL_CAP, tooltip="Number of drawings retained per enabled calendar channel when Unlimited is off.", group=calendarSettingsGroup)
string calendarTimeframeLimit = input.timeframe("60", "Timeframe Limit", tooltip="Calendar separators, labels, and custom timestamps do not appear above this chart timeframe.", group=calendarSettingsGroup)
string calendarTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "GMT-12", "GMT-11", "GMT-10", "GMT-9", "GMT-8", "GMT-7", "GMT-6", "GMT-5", "GMT-4", "GMT-3", "GMT-2", "GMT-1", "GMT+0", "GMT+1", "GMT+2", "GMT+3", "GMT+4", "GMT+5", "GMT+6", "GMT+7", "GMT+8", "GMT+9", "GMT+10", "GMT+11", "GMT+12", "GMT+13", "GMT+14"], tooltip="America/New_York adjusts for Daylight Saving Time. Fixed GMT selections do not.", group=calendarSettingsGroup)
color calendarTextColor = input.color(color.rgb(120, 123, 134), "Day Label Color", group=calendarSettingsGroup)
string calendarPeriodGroup = "Calendar - Day / Week / Month / Year"
bool calendarSeparatorsUnlimited = input.bool(false, "Unlimited", tooltip="Uses the larger rolling safety history for each selected separator channel.", group=calendarPeriodGroup)
bool calendarShowDaily = input.bool(false, "Daily Separators", inline="CAL_D", group=calendarPeriodGroup)
color calendarDailyColor = input.color(color.rgb(54, 58, 69), "", inline="CAL_D", group=calendarPeriodGroup)
bool calendarShowWeekly = input.bool(false, "Weekly Separators", inline="CAL_W", group=calendarPeriodGroup)
color calendarWeeklyColor = input.color(color.rgb(54, 58, 69), "", inline="CAL_W", group=calendarPeriodGroup)
bool calendarShowMonthly = input.bool(false, "Monthly Separators", inline="CAL_M", group=calendarPeriodGroup)
color calendarMonthlyColor = input.color(color.rgb(54, 58, 69), "", inline="CAL_M", group=calendarPeriodGroup)
bool calendarShowYearly = input.bool(false, "Yearly Separators", inline="CAL_Y", group=calendarPeriodGroup)
color calendarYearlyColor = input.color(color.rgb(54, 58, 69), "", inline="CAL_Y", group=calendarPeriodGroup)
string calendarSeparatorStyleInput = input.string("Solid", "Separator Style", options=["Solid", "Dotted", "Dashed"], inline="CAL_STYLE", group=calendarPeriodGroup)
int calendarSeparatorWidth = input.int(1, "", minval=1, maxval=4, inline="CAL_STYLE", group=calendarPeriodGroup)
bool calendarShowDayLabels = input.bool(false, "Day of Week Labels", inline="CAL_DOW", group=calendarPeriodGroup)
string calendarDayLabelY = input.string("Bottom", "", options=["Top", "Bottom"], inline="CAL_DOW", group=calendarPeriodGroup)
string calendarDayLabelX = input.string("Midnight", "", options=["Midnight", "Midday"], inline="CAL_DOW", group=calendarPeriodGroup)
bool calendarHideWeekendLabels = input.bool(false, "Hide Weekend Labels", group=calendarPeriodGroup)
string calendarTimestampGroup = "Timestamps"
bool calendarTimestampsUnlimited = input.bool(false, "Unlimited", tooltip="Uses the larger rolling safety history for each enabled timestamp channel.", group=calendarTimestampGroup)
bool calendarUseTimestamp1 = input.bool(false, "", inline="CAL_V1", group=calendarTimestampGroup)
string calendarTimestamp1 = input.session("0000-0001", "", inline="CAL_V1", group=calendarTimestampGroup)
color calendarTimestamp1Color = input.color(color.rgb(242, 54, 69), "", inline="CAL_V1", group=calendarTimestampGroup)
bool calendarUseTimestamp2 = input.bool(false, "", inline="CAL_V2", group=calendarTimestampGroup)
string calendarTimestamp2 = input.session("0700-0801", "", inline="CAL_V2", group=calendarTimestampGroup)
color calendarTimestamp2Color = input.color(color.rgb(60, 70, 80), "", inline="CAL_V2", group=calendarTimestampGroup)
bool calendarUseTimestamp3 = input.bool(false, "", inline="CAL_V3", group=calendarTimestampGroup)
string calendarTimestamp3 = input.session("1000-1001", "", inline="CAL_V3", group=calendarTimestampGroup)
color calendarTimestamp3Color = input.color(color.rgb(60, 70, 80), "", inline="CAL_V3", group=calendarTimestampGroup)
bool calendarUseTimestamp4 = input.bool(false, "", inline="CAL_V4", group=calendarTimestampGroup)
string calendarTimestamp4 = input.session("1200-1201", "", inline="CAL_V4", group=calendarTimestampGroup)
color calendarTimestamp4Color = input.color(color.rgb(60, 70, 80), "", inline="CAL_V4", group=calendarTimestampGroup)
string calendarTimestampStyleInput = input.string("Dotted", "Style", options=["Solid", "Dotted", "Dashed"], inline="CAL_V_STYLE", group=calendarTimestampGroup)
int calendarTimestampWidth = input.int(1, "", minval=1, maxval=4, inline="CAL_V_STYLE", group=calendarTimestampGroup)
var array<label> calendarDayLabelHistory = array.new_label()
f_addBandzCalendarLine(int channel, color drawingColor, string styleInput, int drawingWidth, bool unlimited) =>
    int keepCount = unlimited ? BANDZ_CALENDAR_CHANNEL_CAP : calendarDrawingLimit
    f_prepareBandzLineRecord(BANDZ_LINE_OWNER_CALENDAR, channel, keepCount, 1)
    line drawing = line.new(
         x1=time, y1=low - syminfo.mintick,
         x2=time, y2=high + syminfo.mintick,
         xloc=xloc.bar_time, extend=extend.both,
         color=drawingColor, style=f_lineStyle(styleInput), width=drawingWidth,
         force_overlay=true)
    array<line> recordLines = array.new_line()
    recordLines.push(drawing)
    f_storeBandzLineRecord(BANDZ_LINE_OWNER_CALENDAR, channel, recordLines, na)
f_bandzCalendarDayName(int dayNumber) =>
    switch dayNumber
        dayofweek.sunday => "SUNDAY"
        dayofweek.monday => "MONDAY"
        dayofweek.tuesday => "TUESDAY"
        dayofweek.wednesday => "WEDNESDAY"
        dayofweek.thursday => "THURSDAY"
        dayofweek.friday => "FRIDAY"
        dayofweek.saturday => "SATURDAY"
        => ""
float calendarChartSeconds = timeframe.in_seconds(timeframe.period)
float calendarLimitSeconds = timeframe.in_seconds(calendarTimeframeLimit)
bool calendarWithinTimeframeLimit = timeframe.isintraday and not na(calendarChartSeconds) and
     not na(calendarLimitSeconds) and calendarChartSeconds <= calendarLimitSeconds
int calendarLocalYear = year(time, calendarTimezone)
int calendarLocalMonth = month(time, calendarTimezone)
int calendarLocalDay = dayofmonth(time, calendarTimezone)
int calendarLocalWeekday = dayofweek(time, calendarTimezone)
int calendarLocalMinute = hour(time, calendarTimezone) * 60 + minute(time, calendarTimezone)
int calendarLocalDateKey = calendarLocalYear * 10000 + calendarLocalMonth * 100 + calendarLocalDay
int calendarLocalMonthKey = calendarLocalYear * 100 + calendarLocalMonth
int calendarDaysSinceMonday = (calendarLocalWeekday - dayofweek.monday + 7) % 7
int calendarLocalNoon = timestamp(
     calendarTimezone, calendarLocalYear, calendarLocalMonth, calendarLocalDay, 12, 0)
int calendarMondayProbe = calendarLocalNoon - calendarDaysSinceMonday * 24 * 60 * 60 * 1000
int calendarLocalWeekKey = year(calendarMondayProbe, calendarTimezone) * 10000 +
     month(calendarMondayProbe, calendarTimezone) * 100 +
     dayofmonth(calendarMondayProbe, calendarTimezone)
bool calendarHasPreviousBar = bar_index > 0
bool calendarNewDay = calendarHasPreviousBar and calendarLocalDateKey != calendarLocalDateKey[1]
bool calendarNewWeeklyPeriod = calendarHasPreviousBar and calendarLocalWeekKey != calendarLocalWeekKey[1]
bool calendarNewMonthlyPeriod = calendarHasPreviousBar and calendarLocalMonthKey != calendarLocalMonthKey[1]
bool calendarNewYear = calendarHasPreviousBar and calendarLocalYear != calendarLocalYear[1]
bool calendarTimestamp1Active = not na(time(timeframe.period, calendarTimestamp1, calendarTimezone))
bool calendarTimestamp2Active = not na(time(timeframe.period, calendarTimestamp2, calendarTimezone))
bool calendarTimestamp3Active = not na(time(timeframe.period, calendarTimestamp3, calendarTimezone))
bool calendarTimestamp4Active = not na(time(timeframe.period, calendarTimestamp4, calendarTimezone))
if calendarWithinTimeframeLimit
    if calendarShowDaily and calendarNewDay
        f_addBandzCalendarLine(BANDZ_CALENDAR_DAILY_CHANNEL, calendarDailyColor, calendarSeparatorStyleInput, calendarSeparatorWidth, calendarSeparatorsUnlimited)
    if calendarShowWeekly and calendarNewWeeklyPeriod
        f_addBandzCalendarLine(BANDZ_CALENDAR_WEEKLY_CHANNEL, calendarWeeklyColor, calendarSeparatorStyleInput, calendarSeparatorWidth, calendarSeparatorsUnlimited)
    if calendarShowMonthly and calendarNewMonthlyPeriod
        f_addBandzCalendarLine(BANDZ_CALENDAR_MONTHLY_CHANNEL, calendarMonthlyColor, calendarSeparatorStyleInput, calendarSeparatorWidth, calendarSeparatorsUnlimited)
    if calendarShowYearly and calendarNewYear
        f_addBandzCalendarLine(BANDZ_CALENDAR_YEARLY_CHANNEL, calendarYearlyColor, calendarSeparatorStyleInput, calendarSeparatorWidth, calendarSeparatorsUnlimited)
    if calendarUseTimestamp1 and calendarTimestamp1Active and not calendarTimestamp1Active[1]
        f_addBandzCalendarLine(BANDZ_CALENDAR_TIMESTAMP_1_CHANNEL, calendarTimestamp1Color, calendarTimestampStyleInput, calendarTimestampWidth, calendarTimestampsUnlimited)
    if calendarUseTimestamp2 and calendarTimestamp2Active and not calendarTimestamp2Active[1]
        f_addBandzCalendarLine(BANDZ_CALENDAR_TIMESTAMP_2_CHANNEL, calendarTimestamp2Color, calendarTimestampStyleInput, calendarTimestampWidth, calendarTimestampsUnlimited)
    if calendarUseTimestamp3 and calendarTimestamp3Active and not calendarTimestamp3Active[1]
        f_addBandzCalendarLine(BANDZ_CALENDAR_TIMESTAMP_3_CHANNEL, calendarTimestamp3Color, calendarTimestampStyleInput, calendarTimestampWidth, calendarTimestampsUnlimited)
    if calendarUseTimestamp4 and calendarTimestamp4Active and not calendarTimestamp4Active[1]
        f_addBandzCalendarLine(BANDZ_CALENDAR_TIMESTAMP_4_CHANNEL, calendarTimestamp4Color, calendarTimestampStyleInput, calendarTimestampWidth, calendarTimestampsUnlimited)
bool calendarCrossedMidday = calendarHasPreviousBar and calendarLocalMinute >= 12 * 60 and
     (calendarNewDay or calendarLocalMinute[1] < 12 * 60)
bool calendarDayLabelEvent = calendarDayLabelX == "Midday" ? calendarCrossedMidday : calendarNewDay
bool calendarWeekend = calendarLocalWeekday == dayofweek.saturday or calendarLocalWeekday == dayofweek.sunday
if calendarWithinTimeframeLimit and calendarShowDayLabels and calendarDayLabelEvent and
     (not calendarHideWeekendLabels or not calendarWeekend)
    bool labelAtTop = calendarDayLabelY == "Top"
    label dayLabel = label.new(
         x=time, y=labelAtTop ? high : low,
         text=f_bandzCalendarDayName(calendarLocalWeekday),
         xloc=xloc.bar_time, yloc=labelAtTop ? yloc.abovebar : yloc.belowbar,
         style=label.style_none, color=color.new(color.white, 100),
         textcolor=calendarTextColor, size=size.small)
    calendarDayLabelHistory.push(dayLabel)
    while calendarDayLabelHistory.size() > BANDZ_CALENDAR_LABEL_CAP
        label.delete(calendarDayLabelHistory.shift())

     lookahead = barmerge.lookahead_off
)
var int lastHtfDailyFvgEvent = na
var array<box> htfDailyMainBoxes = array.new_box()
var array<label> htfDailyMainLabels = array.new_label()
newHtfDailyFvgEvent = not na(htfDailyFvgEventId) and (
     na(lastHtfDailyFvgEvent) or
